# ==============================================================================
# LeadFlow Configuration (.env.example)
# Copy this file to .env for local development or Docker Compose execution.
# Never commit real credentials or secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
# Used by Docker Compose (db service) and backend connection string:
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=leadflow

# Database URL used by FastAPI backend and Alembic:
# - For Docker Compose: postgresql+psycopg2://postgres:postgres@db:5432/leadflow
# - For Local PostgreSQL: postgresql+psycopg2://postgres:postgres@localhost:5432/leadflow
# - For Local SQLite development: sqlite:///./leadflow.db
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/leadflow

# ------------------------------------------------------------------------------
# 2. Backend Application Configuration
# ------------------------------------------------------------------------------
# Application Environment (development, test, production)
APP_ENV=development

# Allowed CORS origins for the FastAPI backend (comma-separated):
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 3. Frontend Client Configuration
# ------------------------------------------------------------------------------
# Browser-accessible API URL for the Next.js frontend application.
# For local dev and standard Docker Compose, the browser accesses the host on port 8000:
NEXT_PUBLIC_API_URL=http://localhost:8000
